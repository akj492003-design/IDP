# Flask/API
APP_ENV=development
SECRET_KEY=replace-with-a-new-random-secret-at-least-32-bytes
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
MAX_UPLOAD_MB=10
FILE_STORAGE_PATH=./storage

# MongoDB / Redis (Docker Compose overrides internal service URLs)
MONGODB_URI=mongodb://localhost:27018/?retryWrites=true&w=majority
MONGODB_DB=idp_system
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Google OAuth Web application credentials. Client secret is backend-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173

# Optional transactional email integration. Configure only after rotating any exposed key.
BREVO_API_KEY=replace-with-a-new-rotated-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_EMAIL_SENDER_NAME=IDP System
BREVO_SMS_SENDER=IDPSystem
RESET_TOKEN_TTL_MINUTES=30

# Razorpay (optional; leave blank until checkout is configured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Model loading / OCR
EFFICIENTNET_MODEL_PATH=./app/models/efficientnetb0_idp_classifier
ORIENTATION_CONFIDENCE_THRESHOLD=0.80
PADDLEOCR_LANG=en
PADDLE_PDX_MODEL_SOURCE=bos
PADDLE_PDX_CACHE_HOME=/app/model_cache
ENABLE_IMAGE_CLASSIFIER=true
